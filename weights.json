{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "version": "1.0.0",
  "description": "Preset weight configurations for default model/scoring calculations.",
  "metadata": {
    "last_updated": "2026-10-01",
    "environment": "production"
  },
  "weights": {
    "relevance": 0.40,
    "quality_score": 0.30,
    "recency": 0.20,
    "user_engagement": 0.10
